meta {
  name: Callback
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/callback?code=CODE&state=STATE
  body: none
  auth: none
}

params:query {
  code: CODE
  state: STATE
}

script:pre-request {
  req.setMaxRedirects(0);
}

docs {
  authCallback. The IdP redirects here with real values; with made-up ones expect 400 problem+json.
}
