# Copy to .env (never commit .env). `make` loads .env automatically.
# Running Go or npm directly does not: export these values first, for example
# HTTP_ADDR=:8085 go run ./cmd/server
APP_ENV=development
HTTP_ADDR=:8085
# Matches docker-compose.yml (host port 5435, PostgreSQL 17).
DATABASE_URL=postgres://marker:marker@localhost:5435/marker?sslmode=disable
# Maximum concurrent page fetches. Optional; the default is 4.
# FETCH_CONCURRENCY=4
# The app's origin as the browser sees it (the Vite dev server). Used for the CSRF
# origin check, and cookies get the Secure flag when this is https. No trailing slash.
APP_BASE_URL=http://localhost:5175
# Development only: GET /auth/dev-login?name=alice signs in without Kinde. The server
# refuses to start with this set unless APP_ENV=development.
AUTH_DEV_LOGIN=true
