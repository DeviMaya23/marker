# Copy to .env (never commit .env). `make` loads .env automatically.
# Running Go or npm directly does not: export these values first, for example
# HTTP_ADDR=:8085 go run ./cmd/server
APP_ENV=development
HTTP_ADDR=:8085
# Matches docker-compose.yml (host port 5435, PostgreSQL 17).
DATABASE_URL=postgres://marker:marker@localhost:5435/marker?sslmode=disable
# Maximum concurrent page fetches. Optional; the default is 4.
# FETCH_CONCURRENCY=4
# The app's origin as the browser sees it (the Vite dev server). Used for the CSRF
# origin check, and cookies get the Secure flag when this is https. No trailing slash.
APP_BASE_URL=http://localhost:5175
# Development only: GET /auth/dev-login?name=alice signs in without Kinde. The server
# refuses to start with this set unless APP_ENV=development.
AUTH_DEV_LOGIN=true

# Kinde login (OIDC authorization-code flow). Setting OIDC_ISSUER_URL turns it on, and
# then the other four required values must be set too; the server refuses to start with
# only some of them. Never commit values for the two secrets.
# The issuer exactly as the identity provider publishes it (no trailing-slash handling).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# The client secret. Leave empty here and set it in your gitignored .env.
OIDC_CLIENT_SECRET=
# The identity provider's logout endpoint, a full URL. UNVERIFIED GUESS: https://<kinde-domain>/logout
OIDC_LOGOUT_URL=
# Name of the logout URL's return-address query parameter. UNVERIFIED GUESS; the default is redirect.
# OIDC_LOGOUT_REDIRECT_PARAM=redirect
# Signs the login state and derives the PKCE verifier. Its own bytes are the key; at
# least 32 bytes. Leave empty here and set it in your gitignored .env.
AUTH_STATE_SECRET=

# Optional. The header that carries the client's IP address, for the per-IP limit on the
# login routes. Set it when the server runs behind a proxy that sets it (for example
# CF-Connecting-IP behind Cloudflare) and is reachable only through that proxy; the value
# is trusted as sent. Empty uses the connection address.
# CLIENT_IP_HEADER=CF-Connecting-IP

# The value the Cloudflare Worker sends in the X-Proxy-Secret header; the server answers
# 404 to any request (except GET /healthz) without it. Required in production, at least
# 32 visible ASCII characters (for example `openssl rand -hex 32`). Set it in the secret
# store, never commit it.
# PROXY_SHARED_SECRET=
